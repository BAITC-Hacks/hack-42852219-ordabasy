APP_APP_NAME=AstanaInnovation
APP_ENV=development
APP_DEBUG=false
APP_API_V1_PREFIX=/api/v1
APP_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Browser-facing URL: relative /api works with the frontend served by FastAPI.
# For a separately hosted frontend, use the publicly reachable backend URL.
APP_PUBLIC_API_BASE_URL=/api
# remote = calls OpenAI for POST /api/analysis, mock = explicit frontend demo, disabled = no AI requests.
APP_ANALYSIS_MODE=remote
APP_OPENAI_MODEL=gpt-4o-mini

# Docker host publishing; the server always listens on 0.0.0.0:8000 inside Docker.
APP_HOST=127.0.0.1
APP_PORT=8000

# Required for POST /api/analysis in "remote" mode; passed to the backend at
# runtime only. Without it (or in mock/disabled mode) the route responds 404
# and calculation still works.
OPENAI_API_KEY=
